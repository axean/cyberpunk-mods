{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "LuaJIT",
  "workspace.library": ["typings/cet"],
  "workspace.checkThirdParty": false,
  "workspace.ignoreDir": [".venv", ".git", "build", "dissected", "snapshots", "thirdparty"],
  "diagnostics.groupFileStatus": {
    "ambiguity": "Any",
    "await": "Any",
    "codestyle": "None",
    "conventions": "Any",
    "duplicate": "Any",
    "global": "Any",
    "luadoc": "Any",
    "redefined": "Any",
    "strict": "Any",
    "strong": "Any",
    "type-check": "Any",
    "unbalanced": "Any",
    "unused": "Any"
  },
  "type.weakNilCheck": false,
  "type.weakUnionCheck": false,
  "type.castNumberToInteger": false
}
